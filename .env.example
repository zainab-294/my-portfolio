# ==============================================================================
# Portfolio Contact Form Server — Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Fill in your real SMTP email service credentials below.
# 3. Keep your real '.env' file private and never commit it to Git.
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Destination Email: Where contact messages should be delivered
CONTACT_TO_EMAIL=zainab.dev@example.com

# ==============================================================================
# SMTP Mail Delivery Service Configuration
# ------------------------------------------------------------------------------
# You can use standard SMTP credentials from providers like:
# - Gmail (smtp.gmail.com, port 587, requires an App Password from Google Account Security)
# - Outlook (smtp.office365.com, port 587)
# - Resend SMTP (smtp.resend.com, port 465 or 587)
# - SendGrid, Brevo, Mailgun, Postmark, etc.
# ==============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-password-or-app-key
SMTP_FROM_NAME="Portfolio Contact Form"
SMTP_FROM_EMAIL=your-smtp-username@example.com

# Testing Option:
# Set to 'true' in development to automatically generate a free Ethereal SMTP test account
# with a real preview URL logged in the server terminal, without needing personal credentials.
USE_TEST_ACCOUNT=false
